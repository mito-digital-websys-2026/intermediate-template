{
  "name": "intermediate (frontend)",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "frontend",
  "runServices": ["frontend", "backend", "db"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Next.js (frontend)" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  },

  "postCreateCommand": "npm install --prefix frontend"
}
